# Copy this file to .env.deploy and fill in your values.
# NEVER commit .env.deploy to GitHub.

# GitHub (empty repo you already created)
GITHUB_REPO_URL=https://github.com/YOUR_USERNAME/assignment-portal.git
GITHUB_PAT=ghp_your_personal_access_token

# Neon PostgreSQL — from neon.tech → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Supabase Storage — Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Security
JWT_SECRET=use-a-long-random-string-at-least-32-characters
TEACHER_PASSWORD=YourStrongTeacherPassword123!

# Vercel — vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token

# After Render deploy, paste your API URL here (optional, for reference)
# RENDER_API_URL=https://assignment-portal-api.onrender.com
