USE_SQLITE=true
PORT=8000
NODE_ENV=development

# Set USE_SQLITE=false and provide DATABASE_URL for PostgreSQL (Neon / Supabase / Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assignment_portal

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# File storage: local (dev) or supabase (production on Render)
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=200

# Supabase Storage (free 1GB) — set STORAGE_TYPE=supabase in production
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Default teacher account (created on seed)
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=teacher123

# CORS
FRONTEND_URL=http://localhost:5173
