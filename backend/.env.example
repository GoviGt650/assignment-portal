USE_SQLITE=true
PORT=8000
NODE_ENV=development

# Set USE_SQLITE=false and provide DATABASE_URL for PostgreSQL (Neon / Supabase / Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assignment_portal

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# File storage: local (dev) or supabase (production on Render)
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=200

# Supabase Storage (free 1GB) — set STORAGE_TYPE=supabase in production
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Default teacher account (created on seed)
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=teacher123

# CORS
FRONTEND_URL=http://localhost:5173

# Email OTP via Brevo SMTP + Nodemailer (free: 300 emails/day)
# Setup: https://www.brevo.com → sign up (free)
# 1. Senders & IP → Senders → add your email → verify via link (no domain needed)
# 2. SMTP & API → SMTP → generate SMTP key
# 3. Set SMTP_USER to the "Login" shown on that page (xxx@smtp-brevo.com — NOT your Gmail)
# 4. Set SMTP_PASS to the generated SMTP key
# 5. EMAIL_FROM must EXACTLY match a verified sender in Brevo (character-for-character).
#    Example: if Brevo shows govind.jadapalli92@gmail.com verified, use that exact spelling in EMAIL_FROM.
#    Gmail ignores dots, but Brevo does not — govindjadapalli92@gmail.com ≠ govind.jadapalli92@gmail.com for Brevo.
# Optional: email teacher when a student submits work
TEACHER_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
